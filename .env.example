# Vercel Postgres — only needed for the global leaderboard.
# In local dev without these vars the leaderboard degrades gracefully
# (shows a "not available" message in-game).
#
# How to get these values:
#   1. Go to vercel.com → your project → Storage → Create Database → Postgres
#   2. Copy the connection strings from the "Quickstart" tab
#   3. Paste them here and also add them as Environment Variables in Vercel settings

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
